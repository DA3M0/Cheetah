#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer MatrixA {
    float values[];
} a;

layout(set = 0, binding = 1, std430) readonly buffer MatrixB {
    uint values[];
} b;

layout(set = 0, binding = 2, std430) writeonly buffer MatrixC {
    float values[];
} c;

layout(push_constant) uniform Dimensions {
    uint m;
    uint k;
    uint n;
    uint transpose_b;
} dimensions;

float load_bf16(uint index) {
    uint packed = b.values[index >> 1];
    uint component = index & 1u;
    if ((dimensions.transpose_b & 2u) != 0u) {
        vec2 half_values = unpackHalf2x16(packed);
        return component == 0u ? half_values.x : half_values.y;
    }
    uint value = component == 0u ? (packed & 0xffffu) : (packed >> 16u);
    return uintBitsToFloat(value << 16u);
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint column = gl_GlobalInvocationID.x;
    if (row >= dimensions.m || column >= dimensions.n) {
        return;
    }

    float sum = 0.0;
    for (uint index = 0; index < dimensions.k; ++index) {
        uint b_index = (dimensions.transpose_b & 1u) == 0u
                           ? index * dimensions.n + column
                           : column * dimensions.k + index;
        sum += a.values[row * dimensions.k + index] *
               load_bf16(b_index);
    }
    c.values[row * dimensions.n + column] = sum;
}
